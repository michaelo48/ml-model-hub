{
  "name": "modelforge",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @modelforge/web dev",
    "dev:worker": "pnpm --filter @modelforge/worker dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:push": "supabase db push --linked",
    "db:migration": "supabase migration new",
    "db:types": "supabase gen types typescript --linked --schema public > apps/web/src/lib/supabase/database.types.ts"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
