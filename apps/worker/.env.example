# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Secret key (sb_secret_...). The worker is a trusted backend and bypasses RLS.
# Never commit the real value and never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Optional
# WORKER_ID=worker-1
# POLL_INTERVAL_MS=3000
# HEARTBEAT_INTERVAL_MS=10000
# METRICS_FLUSH_MS=250
# REAP_INTERVAL_MS=60000
# STALE_JOB_AFTER=5 minutes        # "<n> seconds|minutes|hours"; must be >= 3x HEARTBEAT_INTERVAL_MS
# MAX_ATTEMPTS=3
# SHUTDOWN_GRACE_MS=25000
# DATASET_URL_TTL_SECONDS=600      # signed URL lifetime handed to the training thread
# REQUEST_TIMEOUT_MS=30000         # abort deadline for every Supabase request
# SWEEP_INTERVAL_MS=21600000       # orphaned-storage sweep cadence (6 h); 0 disables
# SWEEP_GRACE_MS=3600000           # unreferenced objects younger than this are left alone

# Only needed for `pnpm test:rls` (integration tests sign in as throwaway users)
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
