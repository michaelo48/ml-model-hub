# Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Secret key (sb_secret_...). The worker is a trusted backend and bypasses RLS.
# Never commit the real value and never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Optional
# WORKER_ID=worker-1
# POLL_INTERVAL_MS=3000
# HEARTBEAT_INTERVAL_MS=10000
