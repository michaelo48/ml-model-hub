# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable key (new format, safe for the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secret key (server-only: route handlers and worker). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Public origin of this deployment, no trailing slash. Used for absolute URLs
# shown to users (the curl example on the model page). Falls back to the
# request Host header in local dev only.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
